<native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
  <interface>
    {% for intf in interfaces %}
    {% set itype = intf.name.rstrip('0123456789') %}
    {% set inum = intf.name|replace(itype, '') %}
    <{{ itype }}>
      <name>{{ inum }}</name>
      {% if intf.description %}<description>{{ intf.description }}</description>{% endif %}
      <ip>
        <address>
          <primary>
            <address>{{ intf.ipv4_address }}</address>
            <mask>{{ intf.ipv4_netmask }}</mask>
          </primary>
        </address>
      </ip>
      {% if intf.enabled == 0 %}<shutdown/>{% endif %}
    </{{ itype }}>
    {% endfor %}
  </interface>
</native>
