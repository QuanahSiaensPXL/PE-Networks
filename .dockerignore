# Versiebeheer — niet nodig in de image
.git
.gitignore

# Python / virtual env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — alleen via runtime env-vars of mounted volume
.env

